# Copy this file to .env and paste your real keys in.
# Once .env exists, every script here picks these up automatically --
# no `export` needed, no retyping every time you open a new terminal.
#
# .env is already excluded from git (see .gitignore), so it never gets
# uploaded or committed by accident. Still: never paste a real key into
# chat, a screenshot, or anywhere someone else could see it.

# --- Answer engine: fill in ONE of these two sections, not both -----------

# Option A -- Claude via the Anthropic API directly.
# Get it from: https://console.anthropic.com -> API Keys -> Create Key
ANTHROPIC_API_KEY=

# Option B -- a model deployed in your Azure account (e.g. GPT via Azure
# OpenAI / Azure AI Foundry) instead. If both AZURE_OPENAI_API_KEY and
# AZURE_OPENAI_ENDPOINT are filled in, vector_search.py uses this instead
# of Anthropic automatically -- you don't need to also comment out Option A.
# Get these from: Azure Portal -> your Azure OpenAI / AI Foundry resource
#   AZURE_OPENAI_API_KEY: Keys and Endpoint -> KEY 1
#   AZURE_OPENAI_ENDPOINT: Keys and Endpoint -> Endpoint (e.g. https://your-resource.openai.azure.com)
#   AZURE_OPENAI_DEPLOYMENT: Deployments -> the name YOU gave the model when
#     you deployed it (e.g. "gpt-4o") -- not necessarily the model's own name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Required for: azure_blob.py (upload / list / url / download)
# Get it from: Azure Portal -> your storage account -> Access keys -> key1 -> Connection string
AZURE_STORAGE_CONNECTION_STRING=

# Optional -- for real embeddings in vector_search.py build.
# Without this, it falls back to a free local approximation (see README.md Step 7).
# Get it from: https://dashboard.voyageai.com -> API Keys
VOYAGE_API_KEY=

# Optional overrides -- fine to leave blank, sensible defaults are used.
EMBEDDING_MODEL=
GOVERNANCE_MODEL=
