# Copy this file to .env and paste your real keys in.
# Once .env exists, every script here picks these up automatically --
# no `export` needed, no retyping every time you open a new terminal.
#
# .env is already excluded from git (see .gitignore), so it never gets
# uploaded or committed by accident. Still: never paste a real key into
# chat, a screenshot, or anywhere someone else could see it.

# ============================================================================
# ANSWER ENGINE -- fill in ONE of these two sections, not both
# ============================================================================

# Option A -- Claude via the Anthropic API directly.
# Get it from: https://console.anthropic.com -> API Keys -> Create Key
ANTHROPIC_API_KEY=

# Option B -- a model deployed in your Azure account (e.g. GPT via Azure
# OpenAI / Azure AI Foundry) instead. If both AZURE_OPENAI_API_KEY and
# AZURE_OPENAI_ENDPOINT are filled in, vector_search.py uses this instead
# of Anthropic automatically -- you don't need to also comment out Option A.
# Get these from: Azure Portal -> your Azure OpenAI / AI Foundry resource
#   AZURE_OPENAI_API_KEY: Keys and Endpoint -> KEY 1
#   AZURE_OPENAI_ENDPOINT: Keys and Endpoint -> Endpoint (e.g. https://your-resource.openai.azure.com)
#   AZURE_OPENAI_DEPLOYMENT: Deployments -> the name YOU gave the model when
#     you deployed it (e.g. "gpt-4o") -- not necessarily the model's own name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ============================================================================
# EMBEDDINGS -- fill in ONE of these two
# ============================================================================

# Option A -- Voyage AI (Anthropic's recommended embedding provider).
# Get it from: https://dashboard.voyageai.com -> API Keys
# Note: accounts with no payment method on file are throttled to 10,000
# tokens/minute -- a single large document can exceed that in one batch.
# Add a payment method on the Voyage billing page to remove the throttle
# (you still get 200M free tokens either way), or use Option B instead.
VOYAGE_API_KEY=

# Option B -- Azure OpenAI embeddings, using the SAME resource as your
# answer engine above, just a second, separate deployment (embeddings and
# chat models are deployed independently even in one resource).
# Get this from: your Azure OpenAI resource -> Deployments -> deploy an
# embeddings model (e.g. text-embedding-3-small) and use the deployment
# name YOU gave it here.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Must match the deployed embedding model's real output size: 1536 for
# text-embedding-3-small / text-embedding-ada-002, 3072 for
# text-embedding-3-large. Wrong number = index creation succeeds but every
# upload fails with a dimension-mismatch error. Only matters if you're also
# using VECTOR_STORE=azure below -- the local store doesn't care.
EMBEDDING_DIMENSIONS=1536

# ============================================================================
# VECTOR STORE -- where chunks + their embeddings get saved and searched
# ============================================================================

# "local" (default) -- a plain index.json file, $0, no setup.
# "azure" -- a real Azure AI Search vector index. Needs the three
# AZURE_SEARCH_* values below AND running `python3 azure_search.py setup`
# once before your first `build`. See README.md "Setting up Azure AI Search".
VECTOR_STORE=local

# Get these from: Azure Portal -> your Azure AI Search resource -> Keys
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=governance-chunks

# ============================================================================
# FILE STORAGE -- raw PDFs / text files (separate from the vector store above)
# ============================================================================

# Get it from: Azure Portal -> your storage account -> Access keys -> key1 -> Connection string
AZURE_STORAGE_CONNECTION_STRING=

# ============================================================================
# Optional overrides -- fine to leave blank, sensible defaults are used.
# ============================================================================
EMBEDDING_MODEL=
GOVERNANCE_MODEL=
