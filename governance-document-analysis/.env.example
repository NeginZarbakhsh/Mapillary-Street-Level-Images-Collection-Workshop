ANTHROPIC_API_KEY=sk-ant-...
# Or use `ant auth login` and leave this unset.

GOVERNANCE_MODEL=claude-opus-5
GOVERNANCE_EFFORT=high

# RAG path (only used for documents/corpora too large for one context window --
# see README "Do you need RAG at all?"). Unset = whole-document mode.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-large

# Retrieval backend when RAG is enabled: "local" (default, in-memory, no
# external service) | "azure" | "mongodb"
VECTOR_STORE=local
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=governance-chunks
MONGODB_URI=
MONGODB_DB=governance
MONGODB_COLLECTION=chunks
