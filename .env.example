# Copy to .env and fill in your own key. .env is gitignored -- never commit a real key.
# Create a REST API key at https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=your-companies-house-rest-api-key

# Zefix (Switzerland) -- request credentials by email to zefix@bj.admin.ch
ZEFIX_USERNAME=your-zefix-username
ZEFIX_PASSWORD=your-zefix-password
